# Site (public, safe to expose). Set the same two in Vercel project settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Sync only (secret). Set as GitHub Actions secrets, never in Vercel/client.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
